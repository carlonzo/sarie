<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardParallelImages"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parallel images (100)"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunParallel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Run" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <TableLayout
            android:id="@+id/tableParallel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="1,2">

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
                <TextView
                    android:id="@+id/tvParallelStockHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="stock"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvParallelSarieHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Sarie"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="total wall"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockWallTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieWallTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="first image"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockFirstImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieFirstImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="per-image p50"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockP50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieP50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="per-image p95"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockP95"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieP95"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="per-image p99"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockP99"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieP99"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

            <TableRow android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="total bytes"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvStockTotalBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvSarieTotalBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="—"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />
            </TableRow>

        </TableLayout>

        <TextView
            android:id="@+id/tvProtocolCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="protocol counts: —" />

        <TextView
            android:id="@+id/tvParallelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
